						<Folder Name="Actions" ID="{4A5E1EBF-4FB1-4F66-A63C-D971743A5335}" ShortID="317834357">
							<Comment>Virtual Folder: solo organiza la vista. No es un contenedor, no afecta el ruteo ni las propiedades (sus hijos siguen heredando de AMX_Player). Agrupa las acciones puntuales de Blobli que no son pisadas.</Comment>
							<ChildrenList>
								<RandomSequenceContainer Name="RND_Gem_Pickup" ID="{7A85E6D9-B76E-4813-B427-C964C89D2B72}" ShortID="630658423">
									<Comment>Recoleccion de gemas. Random Shuffle en Step con 4 variaciones y "Limit repetition to 2": con 4 hijos quedan 2 candidatos, asi que sigue habiendo azar real. Pitch +-200 cents y Volume +-1.5 dB en el contenedor. Es el sonido que mas se repite en una partida (hay gemas por todo el mapa), asi que es donde mas se nota el machine gun effect si no se randomiza.</Comment>
									<PropertyList>
										<Property Name="NormalOrShuffle" Type="int16" Value="0"/>
										<Property Name="Pitch" Type="int32">
											<ModifierList>
												<ModifierInfo>
													<Modifier Name="" ID="{A327ED4F-CAB9-4DA2-A64B-5BE5FCA5DA11}">
														<PropertyList>
															<Property Name="Enabled" Type="bool" Value="True"/>
															<Property Name="Max" Type="Real64" Value="200"/>
															<Property Name="Min" Type="Real64" Value="-200"/>
														</PropertyList>
													</Modifier>
												</ModifierInfo>
											</ModifierList>
										</Property>
										<Property Name="RandomAvoidRepeatingCount" Type="int32" Value="2"/>
										<Property Name="Volume" Type="Real64">
											<ModifierList>
												<ModifierInfo>
													<Modifier Name="" ID="{C7BC06D8-2D90-47A0-9AF1-70C7795EDF3A}">
														<PropertyList>
															<Property Name="Enabled" Type="bool" Value="True"/>
															<Property Name="Max" Type="Real64" Value="1.5"/>
															<Property Name="Min" Type="Real64" Value="-1.5"/>
														</PropertyList>
													</Modifier>
												</ModifierInfo>
											</ModifierList>
										</Property>
									</PropertyList>
									<ReferenceList>
										<Reference Name="OutputBus">
											<ObjectRef Name="Master Audio Bus" ID="{1514A4D8-1DA6-412A-A17E-75CA0C2149F3}" WorkUnitID="{1EA65224-1AAF-4FFB-8BF4-EB5C837966BA}"/>
										</Reference>
									</ReferenceList>
									<ChildrenList>
										<Sound Name="SFX_Gem_Pickup_01" ID="{570B8AF7-FA2B-49A6-B86A-EE09C41F907B}" ShortID="631461140">
