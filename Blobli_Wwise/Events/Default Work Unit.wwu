				<Event Name="Set_Recinto_Altar" ID="{4B6EAB88-AEFF-4886-A38A-373825222984}">
					<Comment>Set State Recinto = Altar, Scope Global. Lo dispara el trigger de entrada a la camara del Altar. El State no crea ni destruye instancias: solo sube el retorno de Aux_Altar de -96 a 0 dB y le mete un Low-pass de 12 a Bus_SFX. Por eso el ambiente no se re-dispara al entrar, simplemente suena distinto.</Comment>
					<ChildrenList>
						<Action Name="" ID="{7BA51D7F-0F06-45C5-B33F-9050049BDC72}">
							<PropertyList>
								<Property Name="ActionType" Type="int16" Value="22"/>
								<Property Name="Scope" Type="int16" Value="1"/>
							</PropertyList>
							<ReferenceList>
								<Reference Name="Target">
									<ObjectRef Name="Altar" ID="{7EF10EDA-3142-4C37-BA92-0DEE88F11F94}" WorkUnitID="{E6C20C4E-F307-422D-94CD-91708460A361}"/>
								</Reference>
							</ReferenceList>
						</Action>
					</ChildrenList>
				</Event>
				<Event Name="Set_Recinto_Exterior" ID="{C4932615-0B85-4A14-97CD-DB1095D44481}">
					<Comment>Set State Recinto = Exterior, Scope Global. Lo dispara el trigger de salida de la camara.</Comment>
					<ChildrenList>
						<Action Name="" ID="{9999BC7F-70E1-4E09-9334-9215A6473935}">
							<PropertyList>
								<Property Name="ActionType" Type="int16" Value="22"/>
